{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "headers": [
      {
        "source": "/mockServiceWorker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/mockServiceWorker.js",
        "destination": "/mockServiceWorker.js"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }